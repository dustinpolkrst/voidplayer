QMainWindow {
    background: {{ color.window_background }};
    color: {{ color.text_primary }};
    font-family: {{ font.ui }};
}
QWidget#appRoot {
    background: {{ color.window_background }};
}
QLabel#videoSurface {
    background: {{ color.video_background }};
    color: {{ color.text_muted }};
    border: 1px solid {{ color.border_video }};
    font-size: 16px;
}
QFrame#videoFrame {
    background: {{ color.video_background }};
    border: 1px solid {{ color.border_video }};
}
QLabel#subtitleOverlay {
    color: {{ color.text_primary }};
    background: rgba(0, 0, 0, 150);
    border-radius: 4px;
    padding: 8px 14px;
    margin: 0 48px 28px 48px;
    font-size: 20px;
}
QPlainTextEdit#inspectorPanel {
    background: {{ color.control_background }};
    color: {{ color.text_secondary }};
    border: 1px solid {{ color.border_control }};
    font-family: {{ font.time_label }};
    font-size: 12px;
}
QLabel#timelinePreview {
    background: {{ color.video_background }};
    color: {{ color.text_primary }};
    border: 1px solid {{ color.border_video }};
    padding: 4px;
}
QFrame#animeHome {
    background: {{ color.home_gradient }};
    border: 1px solid {{ color.border_accent }};
    border-radius: {{ size.panel_radius }};
}
QLabel#animeHomeEyebrow {
    color: {{ color.accent }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0px;
    padding-bottom: 2px;
}
QLabel#animeHomeTitle {
    color: {{ color.text_primary }};
    font-family: {{ font.display }};
    font-size: 34px;
    font-weight: 700;
}
QLabel#animeHomeSubtitle {
    color: {{ color.text_secondary }};
    font-size: 14px;
    padding-bottom: 12px;
}
QFrame#animeHomeSearchPanel {
    background: {{ color.panel_gradient }};
    border: 1px solid {{ color.accent_glow }};
    border-radius: {{ size.panel_radius }};
    padding: 14px;
}
QLineEdit#animeHomeSearchInput {
    background: {{ color.panel_background }};
    color: {{ color.text_primary }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 9px 13px;
    min-height: 34px;
    font-size: 14px;
    selection-background-color: {{ color.accent }};
}
QLineEdit#animeHomeSearchInput:focus {
    border-color: {{ color.accent }};
    background: {{ color.control_background }};
}
QComboBox#animeHomeModeCombo {
    min-height: 34px;
    min-width: 86px;
    padding-left: 12px;
    font-size: 12px;
}
QFrame#animeHomeSearchPanel QPushButton#animePrimaryButton {
    background: {{ color.primary_gradient }};
    border-color: {{ color.accent }};
    color: {{ color.text_button }};
    font-weight: 700;
    min-height: 34px;
    padding: 9px 24px;
}
QFrame#animeHomeSearchPanel QPushButton#animePrimaryButton:hover {
    background: {{ color.button_gradient }};
    border-color: {{ color.accent_soft }};
}
QFrame#animeContinuePanel {
    background: {{ color.panel_gradient }};
    border: 1px solid {{ color.accent_glow }};
    border-radius: {{ size.panel_radius }};
}
QListWidget#animeContinueList {
    background: {{ color.panel_background }};
    color: {{ color.text_secondary }};
    border: 1px solid {{ color.line_soft }};
    border-radius: {{ size.button_radius }};
    outline: 0;
}
QListWidget#animeContinueList::item {
    min-height: 56px;
    padding: 12px 14px;
    border-bottom: 1px solid {{ color.line_soft }};
    font-size: 12px;
}
QListWidget#animeContinueList::item:hover {
    background: {{ color.button_hover_background }};
    color: {{ color.text_primary }};
}
QListWidget#animeContinueList::item:selected {
    background: {{ color.button_gradient }};
    color: {{ color.text_button }};
    border-left: 3px solid {{ color.accent_soft }};
}
QPushButton#animeContinueActionButton {
    background: {{ color.button_gradient }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 8px 14px;
    min-height: 28px;
}
QPushButton#animeContinueActionButton:hover {
    background: {{ color.button_hover_background }};
    border-color: {{ color.border_button_hover }};
}
QPushButton#animeContinueActionButton:disabled {
    color: {{ color.text_muted }};
    background: {{ color.control_background }};
}
QFrame#controlBar {
    background: {{ color.panel_glass }};
    border: 1px solid {{ color.border_control }};
    border-top: 1px solid {{ color.border_accent }};
    border-radius: {{ size.panel_radius }};
    padding: 16px;
}
QFrame#timelineBar {
    background: transparent;
    border: 0;
}
QFrame#buttonBar {
    background: transparent;
    border: 0;
}
QToolButton {
    background: {{ color.button_gradient }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
}
QToolButton:hover {
    background: {{ color.button_hover_background }};
    border-color: {{ color.border_button_hover }};
}
QToolButton:pressed {
    background: {{ color.button_pressed_background }};
}
QLabel#timeLabel {
    color: {{ color.text_time }};
    font-family: {{ font.time_label }};
    font-size: 12px;
    min-width: 78px;
}
QLabel#volumeLabel {
    color: {{ color.text_secondary }};
    font-size: 12px;
}
QLabel#nowPlayingLabel {
    color: {{ color.text_secondary }};
    font-size: 12px;
}
QComboBox {
    background: {{ color.button_gradient }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 4px 32px 4px 8px;
    min-height: 24px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid {{ color.border_button }};
    border-top-right-radius: {{ size.button_radius }};
    border-bottom-right-radius: {{ size.button_radius }};
    background: {{ color.button_background }};
}
QComboBox::down-arrow {
    image: url({{ asset.chevron_down }});
    width: 12px;
    height: 12px;
    margin: 0 7px;
}
QComboBox::drop-down:hover {
    background: {{ color.button_hover_background }};
}
QDialog#animeBrowserDialog {
    background: {{ color.window_background }};
    color: {{ color.text_primary }};
    font-family: {{ font.ui }};
}
QFrame#animeSearchBar,
QFrame#animeBottomBar {
    background: {{ color.panel_gradient }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.panel_radius }};
    padding: 12px;
}
QFrame#animePanel {
    background: {{ color.panel_gradient }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.panel_radius }};
}
QLabel#animePanelTitle {
    color: {{ color.text_primary }};
    font-size: 13px;
    font-weight: 600;
}
QLabel#animeStatus {
    color: {{ color.text_muted }};
    font-size: 12px;
}
QLineEdit#animeSearchInput {
    background: {{ color.panel_background }};
    color: {{ color.text_primary }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 7px 10px;
    min-height: 26px;
}
QPushButton#animePrimaryButton,
QPushButton#animePlayButton {
    background: {{ color.button_gradient }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 7px 18px;
    min-height: 26px;
}
QPushButton#animePrimaryButton:hover,
QPushButton#animePlayButton:hover {
    background: {{ color.button_hover_background }};
    border-color: {{ color.border_button_hover }};
}
QPushButton#animePlayButton:disabled {
    color: {{ color.text_muted }};
    background: {{ color.control_background }};
}
QListWidget#animeResultsList,
QListWidget#animeEpisodesList {
    background: {{ color.panel_background }};
    color: {{ color.text_secondary }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.button_radius }};
    outline: 0;
}
QListWidget#animeResultsList::item,
QListWidget#animeEpisodesList::item {
    min-height: 34px;
    padding: 7px 9px;
    border-bottom: 1px solid {{ color.border_control }};
}
QListWidget#animeResultsList::item:selected,
QListWidget#animeEpisodesList::item:selected {
    background: {{ color.accent }};
    color: {{ color.text_button }};
}
QSlider::groove:horizontal {
    height: 8px;
    background: {{ color.slider_groove }};
    border-radius: 4px;
}
QSlider::sub-page:horizontal {
    background: {{ color.primary_gradient }};
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -7px 0;
    background: {{ color.slider_handle }};
    border: 1px solid {{ color.slider_handle_border }};
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: {{ color.slider_handle_hover }};
    border-color: {{ color.slider_handle_border_hover }};
}
QStatusBar {
    background: {{ color.panel_background }};
    color: {{ color.status_text }};
    border-top: 1px solid {{ color.status_border }};
}
