QMainWindow {
    background: {{ color.window_background }};
    color: {{ color.text_primary }};
}
QWidget#appRoot {
    background: {{ color.window_background }};
}
QLabel#videoSurface {
    background: {{ color.video_background }};
    color: {{ color.text_muted }};
    border: 1px solid {{ color.border_video }};
    font-size: 16px;
}
QFrame#videoFrame {
    background: {{ color.video_background }};
    border: 1px solid {{ color.border_video }};
}
QLabel#subtitleOverlay {
    color: {{ color.text_primary }};
    background: rgba(0, 0, 0, 150);
    border-radius: 4px;
    padding: 8px 14px;
    margin: 0 48px 28px 48px;
    font-size: 20px;
}
QListWidget#playlistDrawer {
    background: {{ color.control_background }};
    color: {{ color.text_secondary }};
    border: 0;
    outline: 0;
}
QListWidget#playlistDrawer::item {
    min-height: 42px;
    padding: 8px 10px;
    border-bottom: 1px solid {{ color.border_control }};
}
QListWidget#playlistDrawer::item:selected {
    background: {{ color.accent }};
    color: {{ color.text_button }};
}
QFrame#playlistPanel {
    background: {{ color.control_background }};
    border: 1px solid {{ color.border_control }};
}
QFrame#playlistHeader {
    background: {{ color.button_background }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 8px;
}
QLabel#playlistTitle {
    color: {{ color.text_primary }};
    font-size: 14px;
    font-weight: 600;
}
QLabel#playlistCount {
    color: {{ color.text_muted }};
    font-size: 12px;
}
QPlainTextEdit#inspectorPanel {
    background: {{ color.control_background }};
    color: {{ color.text_secondary }};
    border: 1px solid {{ color.border_control }};
    font-family: {{ font.time_label }};
    font-size: 12px;
}
QLabel#timelinePreview {
    background: {{ color.video_background }};
    color: {{ color.text_primary }};
    border: 1px solid {{ color.border_video }};
    padding: 4px;
}
QFrame#controlBar {
    background: {{ color.control_background }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.control_radius }};
    padding: 14px;
}
QFrame#timelineBar {
    background: transparent;
    border: 0;
}
QFrame#buttonBar {
    background: transparent;
    border: 0;
}
QToolButton {
    background: {{ color.button_background }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
}
QToolButton:hover {
    background: {{ color.button_hover_background }};
    border-color: {{ color.border_button_hover }};
}
QToolButton:pressed {
    background: {{ color.button_pressed_background }};
}
QLabel#timeLabel {
    color: {{ color.text_time }};
    font-family: {{ font.time_label }};
    font-size: 12px;
    min-width: 78px;
}
QLabel#volumeLabel {
    color: {{ color.text_secondary }};
    font-size: 12px;
}
QComboBox {
    background: {{ color.button_background }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 4px 8px;
    min-height: 24px;
}
QDialog#animeBrowserDialog {
    background: {{ color.window_background }};
    color: {{ color.text_primary }};
}
QFrame#animeSearchBar,
QFrame#animeBottomBar {
    background: {{ color.control_background }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.control_radius }};
    padding: 10px;
}
QFrame#animePanel {
    background: {{ color.control_background }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.control_radius }};
}
QLabel#animePanelTitle {
    color: {{ color.text_primary }};
    font-size: 13px;
    font-weight: 600;
}
QLabel#animeStatus {
    color: {{ color.text_muted }};
    font-size: 12px;
}
QLineEdit#animeSearchInput {
    background: {{ color.video_background }};
    color: {{ color.text_primary }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 7px 10px;
    min-height: 26px;
}
QPushButton#animePrimaryButton,
QPushButton#animePlayButton {
    background: {{ color.button_background }};
    color: {{ color.text_button }};
    border: 1px solid {{ color.border_button }};
    border-radius: {{ size.button_radius }};
    padding: 7px 18px;
    min-height: 26px;
}
QPushButton#animePrimaryButton:hover,
QPushButton#animePlayButton:hover {
    background: {{ color.button_hover_background }};
    border-color: {{ color.border_button_hover }};
}
QPushButton#animePlayButton:disabled {
    color: {{ color.text_muted }};
    background: {{ color.control_background }};
}
QListWidget#animeResultsList,
QListWidget#animeEpisodesList {
    background: {{ color.video_background }};
    color: {{ color.text_secondary }};
    border: 1px solid {{ color.border_control }};
    border-radius: {{ size.button_radius }};
    outline: 0;
}
QListWidget#animeResultsList::item,
QListWidget#animeEpisodesList::item {
    min-height: 34px;
    padding: 7px 9px;
    border-bottom: 1px solid {{ color.border_control }};
}
QListWidget#animeResultsList::item:selected,
QListWidget#animeEpisodesList::item:selected {
    background: {{ color.accent }};
    color: {{ color.text_button }};
}
QSlider::groove:horizontal {
    height: 8px;
    background: {{ color.slider_groove }};
    border-radius: 4px;
}
QSlider::sub-page:horizontal {
    background: {{ color.accent }};
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -7px 0;
    background: {{ color.slider_handle }};
    border: 1px solid {{ color.slider_handle_border }};
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: {{ color.slider_handle_hover }};
    border-color: {{ color.slider_handle_border_hover }};
}
QStatusBar {
    background: {{ color.window_background }};
    color: {{ color.status_text }};
    border-top: 1px solid {{ color.status_border }};
}
